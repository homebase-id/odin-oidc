@page
@model Odin.Oidc.Login.Pages.ConsentModel
@{
    ViewData["Title"] = "Approve";
}
<h1>Sign in to <strong class="domain">@Model.RelyingParty.Shown</strong> as <strong>@Model.Consent.Subject</strong>?</h1>
@if (Model.RelyingParty.Name != null)
{
    <p class="claim">Calling itself &lsquo;@Model.RelyingParty.Name&rsquo;</p>
}
<p>If you allow it, this site learns:</p>
<ul class="grants">
    <li>your identity, @Model.Consent.Subject</li>
    @if (Model.Consent.RequestedScope.Contains("profile"))
    {
        <li>your public name, picture and profile page</li>
    }
    @if (Model.Consent.RequestedScope.Contains("offline") || Model.Consent.RequestedScope.Contains("offline_access"))
    {
        <li>to stay signed in without asking again</li>
    }
</ul>
<form method="post">
    <input type="hidden" name="consent_challenge" value="@Model.ConsentChallenge">
    <div class="actions">
        <button type="submit" name="allow" value="yes">Allow</button>
        <button type="submit" name="allow" value="no" class="secondary">Deny</button>
    </div>
</form>
<p class="muted">Your identity has confirmed who you are to Homebase Sign-in. This question is about what this particular site may know, and your answer is remembered for a month on this browser.</p>
