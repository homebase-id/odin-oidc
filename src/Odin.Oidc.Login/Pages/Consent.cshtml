@page
@model Odin.Oidc.Login.Pages.ConsentModel
@{
    ViewData["Title"] = "Approve";
}
<h1>Let <strong>@Model.RelyingPartyName</strong> know who you are?</h1>
<p>You are signed in as <strong>@Model.Subject</strong>. If you allow it, this site learns:</p>
<ul class="grants">
    @foreach (var grant in Model.Grants)
    {
        <li>@grant</li>
    }
</ul>
<form method="post">
    <input type="hidden" name="consent_challenge" value="@Model.ConsentChallenge">
    <label class="check"><input type="checkbox" name="remember" value="true" checked> Remember this for a month</label>
    <div class="actions">
        <button type="submit" name="allow" value="yes">Allow</button>
        <button type="submit" name="allow" value="no" class="secondary">Deny</button>
    </div>
</form>
<p class="muted">Your identity itself asked you once already, for "Homebase Sign-in"; this is about this site in particular.</p>
