@page
@model Odin.Oidc.Login.Pages.ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}
<h1>Something went wrong</h1>
<p>The sign-in could not continue. Go back to the site you were signing in to and try again.</p>
@if (Model.RequestId != null)
{
    <p class="muted">Reference: <code>@Model.RequestId</code></p>
}
