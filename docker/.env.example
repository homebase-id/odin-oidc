# Copy to docker/.env and adjust. Never commit docker/.env.

# Development: both compose files. Production renders a .env without this line (compose.yml alone).
COMPOSE_FILE=compose.yml:compose.dev.yml

HYDRA_DB_PASSWORD=hydra
# 32+ random characters; Hydra encrypts its stored secrets and signing keys with this (rotation:
# docs/production.md).
HYDRA_SECRETS_SYSTEM=change-me-to-32-or-more-random-characters
# Where relying parties reach Hydra. Baked into every token as `iss`; never changes once a relying
# party has stored a token. Development: http://127.0.0.1:14444/
HYDRA_ISSUER=http://127.0.0.1:14444/
# Where the login app is: Hydra sends the browser here for login, consent and logout, and it is the
# YouAuth client id (its host) and callback. Development: https://collab.dotyou.cloud:8443
LOGIN_APP_URL=https://collab.dotyou.cloud:8443

# Production: the login image from the publish workflow, by tag or digest. Unset, compose.yml names a
# local build (`docker build -t odin-oidc-login .`), which a host without one cannot pull.
#LOGIN_IMAGE=ghcr.io/homebase-id/odin-oidc-login:v0.1.0

# Optional. The oidc network's subnet (proxy trust for Hydra and the login app) and the image digests.
#OIDC_NETWORK=172.30.0.0/24
#HYDRA_IMAGE=oryd/hydra@sha256:...
#POSTGRES_IMAGE=postgres@sha256:...
#BROKER_CLIENT_NAME=Homebase Sign-in
