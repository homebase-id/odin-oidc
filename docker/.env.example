# Copy to docker/.env and adjust. Never commit docker/.env.
HYDRA_DB_PASSWORD=hydra
# 32+ random characters; Hydra encrypts its stored secrets with this. Rotating it invalidates them.
HYDRA_SECRETS_SYSTEM=change-me-to-32-or-more-random-characters
# Where relying parties reach Hydra. Baked into every token as `iss`.
HYDRA_ISSUER=http://127.0.0.1:14444/
# Where Hydra sends the browser for login, consent and logout: the Odin.Oidc.Login app.
LOGIN_APP_URL=https://collab.dotyou.cloud:8443
